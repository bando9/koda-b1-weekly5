@model IEnumerable<Ewallet.Mvc.DTOs.UserResponse>

@{
    ViewData["Title"] = "Select User";
}

<div class="container mt-5">

    <h1 class="text-center mb-2">Welcome to E-Wallet</h1>

    <p class="text-center text-muted mb-5">
        Select a user account to continue.
    </p>

    <div class="row g-4">

        @foreach (var user in Model)
        {
            <div class="col-md-4">
                <div class="card p-3 h-100">

                    <div class="text-center">

                        <img src="@user.Photo"
                             alt="@user.FullName"
                             width="80"
                             height="80"
                             class="rounded-circle mb-3"
                             style="object-fit: cover;" />

                        <h5>@user.FullName</h5>

                        <p class="text-muted">
                            @@ @user.Username
                        </p>

                        <p>@user.Email</p>

                    </div>

                    <a asp-controller="Wallet"
                       asp-action="Details"
                       asp-route-id="@user.Id"
                       class="btn btn-primary mt-auto">

                        Select User

                    </a>

                </div>
            </div>
        }

    </div>

</div>